{
  "manifest_version": 3,
  "name": "Services Directory Toolkit",
  "short_name": "SD Toolkit",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "description": "Diagnostic and query tools for ArcGIS Server REST Services Directory pages. Based on Map Services Enhanced by Ken Doman.",
  "homepage_url": "https://github.com/ggfevans/Services-Directory-Toolkit",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/bg/background.js"
  },
  "options_page": "src/options/options.html",
  "action": {
    "default_icon": "icons/icon19.png",
    "default_title": "Services Directory Toolkit",
    "default_state": "disabled",
    "default_popup": "src/page_action/page_action.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/rest/services",
        "*://*/rest/services?*",
        "*://*/rest/services/*",
        "*://*/*/rest/services",
        "*://*/*/rest/services?*",
        "*://*/*/rest/services/*"
      ],
      "css": [
        "src/inject/inject.css"
      ]
    },
    {
      "matches": [
        "*://*/rest/services",
        "*://*/rest/services?*",
        "*://*/rest/services/*",
        "*://*/*/rest/services",
        "*://*/*/rest/services?*",
        "*://*/*/rest/services/*"
      ],
      "js": [
        "src/lib/dom.js",
        "src/lib/guard.js",
        "src/lib/auth.js",
        "src/lib/url.js",
        "src/lib/net.js",
        "src/lib/page.js",
        "src/inject/inject.js",
        "src/inject/status.js",
        "src/inject/mapImages.js"
      ]
    },
    {
      "matches": [
        "*://*/rest/services/*/query",
        "*://*/rest/services/*/query?*",
        "*://*/*/rest/services/*/query",
        "*://*/*/rest/services/*/query?*"
      ],
      "js": [
        "src/lib/dom.js",
        "src/lib/guard.js",
        "src/lib/auth.js",
        "src/lib/url.js",
        "src/lib/net.js",
        "src/lib/page.js",
        "src/inject/queryTest.js"
      ]
    },
    {
      "matches": [
        "*://*/rest/services/*/GPServer/*/execute",
        "*://*/rest/services/*/GPServer/*/execute?*",
        "*://*/rest/services/*/GPServer/*/submitJob",
        "*://*/rest/services/*/GPServer/*/submitJob?*",
        "*://*/*/rest/services/*/GPServer/*/execute",
        "*://*/*/rest/services/*/GPServer/*/execute?*",
        "*://*/*/rest/services/*/GPServer/*/submitJob",
        "*://*/*/rest/services/*/GPServer/*/submitJob?*"
      ],
      "js": [
        "src/lib/dom.js",
        "src/lib/guard.js",
        "src/lib/auth.js",
        "src/lib/url.js",
        "src/lib/net.js",
        "src/lib/page.js",
        "src/inject/printTask.js"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ]
}
