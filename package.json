{
  "name": "services-directory-toolkit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A Chrome extension with diagnostic and query tools for ArcGIS Server REST Services Directory pages, based on Map Services Enhanced",
  "author": "Gareth Evans",
  "contributors": [
    "Ken Doman <raykendo@gmail.com> (original author)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ggfevans/Services-Directory-Toolkit"
  },
  "bugs": {
    "url": "https://github.com/ggfevans/Services-Directory-Toolkit/issues"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "build": "npm run lint && node scripts/build.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:live": "node tests/live/smoke.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "archiver": "^8.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  }
}
